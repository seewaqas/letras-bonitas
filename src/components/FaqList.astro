---
import type { LandingFaq } from "../data/landings.ts";

interface Props {
  items: readonly LandingFaq[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>
