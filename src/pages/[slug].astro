---
import BaseLayout from "../layouts/BaseLayout.astro";
import Generator from "../components/Generator.astro";
import FaqList from "../components/FaqList.astro";
import AlphabetTable from "../components/AlphabetTable.astro";
import SymbolGrid from "../components/SymbolGrid.astro";
import { LANDINGS } from "../data/landings.ts";
import { hrefFor } from "../data/site.ts";
import { jsonLdScript, pageGraph } from "../lib/seo.ts";

export function getStaticPaths() {
  return LANDINGS.map((landing) => ({
    params: { slug: landing.slug },
    props: { landing },
  }));
}

const { landing } = Astro.props;
const origin = Astro.site?.origin;
const pageUrl = origin ? new URL(hrefFor(landing.slug), origin).href : undefined;
const homeUrl = origin ? new URL("/", origin).href : undefined;
const jsonLd = jsonLdScript(
  pageGraph({
    name: landing.h1,
    description: landing.description,
    url: pageUrl,
    faq: landing.faq,
    crumbs: [
      { name: "Inicio", url: homeUrl },
      { name: landing.h1, url: pageUrl },
    ],
  }),
);
---

<BaseLayout title={landing.title} description={landing.description} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="hero">
      <p class="eyebrow">{landing.eyebrow}</p>
      <h1>{landing.h1}</h1>
      {landing.paragraphs.map((paragraph) => <p class="lede">{paragraph}</p>)}
    </header>
    {
      landing.symbols ? (
        <SymbolGrid />
      ) : (
        <Generator
          sample={landing.sample}
          category={landing.category}
          limit={landing.limit}
          phrases={landing.phrases}
        />
      )
    }
    {landing.alphabet && (
      <section class="section">
        <h2>De la A a la Z, con Ñ</h2>
        <AlphabetTable />
      </section>
    )}
    <section class="section prose">
      <h2>¿Cómo usar el conversor?</h2>
      <ol class="steps">
        {landing.steps.map((step) => <li>{step}</li>)}
      </ol>
    </section>
    {
      landing.sections.map((section) => (
        <section class="section prose">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))
    }
    <section class="section prose">
      <h2>Preguntas frecuentes</h2>
      <FaqList items={landing.faq} />
    </section>
    <section class="section">
      <h2>También te puede servir</h2>
      <div class="related">
        {
          landing.related.map((slug) => {
            const page = LANDINGS.find((item) => item.slug === slug);
            return page ? <a href={hrefFor(page.slug)}>{page.h1}</a> : null;
          })
        }
      </div>
    </section>
  </div>
</BaseLayout>
